<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>SufiChain.SufiTheme.Blazor.WebAssembly.Bundling</RootNamespace>
    <GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
    <IsPackable>true</IsPackable>
    <OutputType>Library</OutputType>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>SufiChain.SufiTheme.Blazor.WebAssembly.Bundling</PackageId>
    <Description>SufiTheme WebAssembly bundling and style contributors for Sufi Platform.</Description>
  </PropertyGroup>


  
