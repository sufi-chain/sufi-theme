<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>SufiChain.SufiTheme.Blazor.WebAssembly.Bundling</RootNamespace>
    <GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
    <IsPackable>true</IsPackable>
    <OutputType>Library</OutputType>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>SufiChain.SufiTheme.Blazor.WebAssembly.Bundling</PackageId>
    <Description>SufiTheme WebAssembly bundling and style contributors for Sufi Platform.</Description>
  </PropertyGroup>


  
  <!--<ItemGroup>
      <ProjectReference Include="..\..\..\..\sufi-platform\framework\SufiChain.SufiPlatform.Core\SufiChain.SufiPlatform.Core.csproj" />
    <ProjectReference Include="..\..\..\..\sufi-platform\framework\SufiChain.SufiPlatform.UI.Abstractions\SufiChain.SufiPlatform.UI.Abstractions.csproj" />
  </ItemGroup>-->


  <ItemGroup Condition="'$(UseSufiProjectReferences)' == 'true'">
    <ProjectReference Include="..\..\..\..\sufi-platform\framework\SufiChain.SufiPlatform.Core\SufiChain.SufiPlatform.Core.csproj" />
    <ProjectReference Include="..\..\..\..\sufi-platform\framework\SufiChain.SufiPlatform.UI.Abstractions\SufiChain.SufiPlatform.UI.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(UseSufiProjectReferences)' != 'true'">
    <PackageReference Include="SufiChain.SufiPlatform.Core" Version="$(SufiVersion)"/>
    <PackageReference Include="SufiChain.SufiPlatform.UI.Abstractions" Version="$(SufiVersion)"/>
  </ItemGroup>


</Project>
