<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>SufiChain.SufiTheme</RootNamespace>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>SufiChain.SufiTheme</PackageId>
    <Description>Core SufiTheme package - options, layouts, and style definitions for Sufi Platform.</Description>
  </PropertyGroup>


  <!--<ItemGroup >
    <PackageReference Include="SufiChain.SufiPlatform.UI.Abstractions" Version="$(SufiVersion)" />
  </ItemGroup>-->


  <ItemGroup Condition="'$(UseSufiProjectReferences)' == 'true'">
    <ProjectReference Include="..\..\..\..\sufi-platform\framework\SufiChain.SufiPlatform.UI.Abstractions\SufiChain.SufiPlatform.UI.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(UseSufiProjectReferences)' != 'true'">
    <PackageReference Include="SufiChain.SufiPlatform.UI.Abstractions" Version="$(SufiVersion)" />
  </ItemGroup>



</Project>
