@inject IStringLocalizer<SufiFrameworkResource> L
@using SufiChain.SufiPlatform.UI.Theming
@inject IThemeSwitchService ThemeSwitchService
@implements IDisposable

<SbIconButton Class="theme-switch-btn"
              OnClick="ToggleThemeAsync"
              Title="@TooltipText"
              AriaLabel="@TooltipText"
              Type="button">
    <span class="theme-icon">
        @if (IsDarkMode)
        {
            <SbIcon Name="sun" Size="SbSize.Md" />
        }
        else
        {
            <SbIcon Name="moon" Size="SbSize.Md" />
        }
    </span>
</SbIconButton>

@code {
    private bool IsDarkMode => ThemeSwitchService.IsDarkMode;
    private string TooltipText => IsDarkMode ? L["Theme:SwitchToLightMode"].Value : L["Theme:SwitchToDarkMode"].Value;

    protected override async Task OnInitializedAsync()
    {
        // Load stored theme preference
        await ThemeSwitchService.GetStoredThemeAsync();
        
        // Subscribe to theme changes
        ThemeSwitchService.ThemeChanged += OnThemeChanged;
    }

    private void OnThemeChanged(ThemeMode mode)
    {
        InvokeAsync(StateHasChanged);
    }

    private async Task ToggleThemeAsync()
    {
        await ThemeSwitchService.ToggleThemeAsync();
    }

    public void Dispose()
    {
        ThemeSwitchService.ThemeChanged -= OnThemeChanged;
    }
}
