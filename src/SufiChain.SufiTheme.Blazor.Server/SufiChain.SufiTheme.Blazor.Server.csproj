<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>SufiChain.SufiTheme.Blazor.Server</RootNamespace>
    <GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
    <IsPackable>true</IsPackable>
    <OutputType>Library</OutputType>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>SufiChain.SufiTheme.Blazor.Server</PackageId>
    <Description>SufiTheme Blazor Server components and layouts for Sufi Platform.</Description>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!--<ItemGroup>
    <PackageReference Include="SufiChain.SufiPlatform.Core" Version="$(SufiVersion)" />
    <PackageReference Include="Volo.Abp.Security" Version="$(AbpVersion)" />
    <PackageReference Include="SufiChain.SufiPlatform.UI" Version="$(SufiVersion)" />
    <PackageReference Include="SufiChain.SufiPlatform.MultiTenancy" Version="$(SufiVersion)" />
    <PackageReference Include="SufiChain.SufiPlatform.Features" Version="$(SufiVersion)" />
    <PackageReference Include="SufiChain.SufiPlatform.UI.Blazor.Server" Version="$(SufiVersion)" />
  </ItemGroup>-->
  

  <ItemGroup>
    <PackageReference Include="Volo.Abp.Security" Version="$(AbpVersion)" />
  </ItemGroup>

  <ItemGroup Condition="'$(UseSufiProjectReferences)' == 'true'">
    <ProjectReference Include="..\..\..\..\sufi-platform\framework\SufiChain.SufiPlatform.Core\SufiChain.SufiPlatform.Core.csproj" />
    <PackageReference Include="Volo.Abp.UI" Version="$(AbpVersion)" />
    <PackageReference Include="Volo.Abp.MultiTenancy" Version="$(AbpVersion)" />
    <ProjectReference Include="..\..\..\..\sufi-platform\framework\SufiChain.SufiPlatform.Features\SufiChain.SufiPlatform.Features.csproj" />
    <ProjectReference Include="..\..\..\..\sufi-platform\framework\SufiChain.SufiPlatform.UI.Blazor.Server\SufiChain.SufiPlatform.UI.Blazor.Server.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(UseSufiProjectReferences)' != 'true'">
    <PackageReference Include="SufiChain.SufiPlatform.Core" Version="$(SufiVersion)" />
    <PackageReference Include="Volo.Abp.UI" Version="$(AbpVersion)" />
    <PackageReference Include="Volo.Abp.MultiTenancy" Version="$(AbpVersion)" />
    <PackageReference Include="SufiChain.SufiPlatform.Features" Version="$(SufiVersion)" />
    <PackageReference Include="SufiChain.SufiPlatform.UI.Blazor.Server" Version="$(SufiVersion)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SufiChain.SufiTheme.Blazor\SufiChain.SufiTheme.Blazor.csproj" />
  </ItemGroup>

</Project>
