@namespace SufiChain.KomTheme.Blazor.Components.Layout

<div class="kom-app-shell @GetShellClasses() @Class">
    @if (Variant == KomAppShellVariant.DualSidebar)
    {
        @* Dual sidebar layout - sidebar full height on left, header+content on right *@
        <div class="kom-app-shell__body">
            @if (DualSidebar != null)
            {
                <CascadingValue Value="this">
                    @DualSidebar
                </CascadingValue>
            }
            
            <div class="kom-app-shell__content-wrapper">
                @if (TopBar != null)
                {
                    <header class="kom-app-shell__header">
                        @TopBar
                    </header>
                }
                
                <main class="kom-app-shell__main">
                    <div class="kom-app-shell__content">
                        @ChildContent
                    </div>
                </main>
            </div>
        </div>
    }
    else
    {
        @* Classic layout - header on top, sidebar + content below *@
        @if (TopBar != null)
        {
            <header class="kom-app-shell__header">
                @TopBar
            </header>
        }
        
        <div class="kom-app-shell__body">
            @if (Sidebar != null)
            {
                <aside class="kom-app-shell__sidebar @(_sidebarCollapsed ? "kom-app-shell__sidebar--collapsed" : "")">
                    <CascadingValue Value="this">
                        @Sidebar
                    </CascadingValue>
                </aside>
            }
            
            <main class="kom-app-shell__main">
                <div class="kom-app-shell__content">
                    @ChildContent
                </div>
            </main>
        </div>
    }
</div>

@code {
    private bool _sidebarCollapsed;
    
    /// <summary>
    /// Top bar content.
    /// </summary>
    [Parameter]
    public RenderFragment? TopBar { get; set; }
    
    /// <summary>
    /// Sidebar content (for Classic variant).
    /// </summary>
    [Parameter]
    public RenderFragment? Sidebar { get; set; }
    
    /// <summary>
    /// Dual sidebar content (for DualSidebar variant).
    /// </summary>
    [Parameter]
    public RenderFragment? DualSidebar { get; set; }
    
    /// <summary>
    /// Main content.
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }
    
    /// <summary>
    /// Layout variant. Defaults to Classic.
    /// </summary>
    [Parameter]
    public KomAppShellVariant Variant { get; set; } = KomAppShellVariant.Classic;
    
    /// <summary>
    /// Whether sidebar is initially collapsed.
    /// </summary>
    [Parameter]
    public bool SidebarCollapsed { get; set; }
    
    /// <summary>
    /// Callback when sidebar collapsed state changes.
    /// </summary>
    [Parameter]
    public EventCallback<bool> SidebarCollapsedChanged { get; set; }
    
    /// <summary>
    /// Additional CSS classes.
    /// </summary>
    [Parameter]
    public string? Class { get; set; }
    
    protected override void OnParametersSet()
    {
        _sidebarCollapsed = SidebarCollapsed;
    }
    
    private string GetShellClasses()
    {
        var classes = new List<string>();
        
        if (_sidebarCollapsed)
        {
            classes.Add("kom-app-shell--sidebar-collapsed");
        }
        
        if (Variant == KomAppShellVariant.DualSidebar)
        {
            classes.Add("kom-app-shell--dual-sidebar");
        }
        
        return string.Join(" ", classes);
    }
    
    /// <summary>
    /// Toggle sidebar collapsed state.
    /// </summary>
    public async Task ToggleSidebarAsync()
    {
        _sidebarCollapsed = !_sidebarCollapsed;
        await SidebarCollapsedChanged.InvokeAsync(_sidebarCollapsed);
    }
    
    /// <summary>
    /// Whether sidebar is collapsed.
    /// </summary>
    public bool IsSidebarCollapsed => _sidebarCollapsed;
}
