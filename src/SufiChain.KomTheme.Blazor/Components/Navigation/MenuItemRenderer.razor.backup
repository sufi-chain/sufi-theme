@*
    MenuItemRenderer - Renders ApplicationMenuItem as sidebar dropdown menu.
    Supports 3 levels: main parent (selected group) → children (Level 0) → grandchildren (Level 1) → great-grandchildren (Level 2).
    Leaf items are wrapped in a level-aware container so siblings align with expandable headers.
*@

@implements IAsyncDisposable
@inject IJSRuntime JS

@if (MenuItem.Items.Any() && Level < MaxLevel)
{
    @* Menu item with children - render as expandable dropdown; use --row when same level as leaf siblings for alignment *@
    <div class="kom-menu-item kom-menu-item--parent @(_isExpanded ? "kom-menu-item--expanded" : "") @(Level == 0 ? "kom-menu-item--row" : "")" style="--menu-level: @Level">
        <button type="button" class="kom-menu-item__header" @onclick="ToggleExpanded">
            <span class="kom-menu-item__icon @(string.IsNullOrEmpty(MenuItem.Icon) && string.IsNullOrEmpty(MenuItem.CustomContent) ? "kom-menu-item__icon--placeholder" : "")">
                @if (!string.IsNullOrEmpty(MenuItem.CustomContent))
                {
                    @((MarkupString)MenuItem.CustomContent)
                }
                else
                {
                    <SbIcon Name="@(string.IsNullOrEmpty(MenuItem.Icon) ? "circle" : MenuItem.Icon)" Size="SbSize.Sm" />
                }
            </span>
            <span class="kom-menu-item__text">@MenuItem.DisplayName</span>
            <span class="kom-menu-item__chevron">
                <SbIcon Name="chevron-down" Size="SbSize.Xs" />
            </span>
        </button>
        <div @ref="_submenuRef" class="kom-menu-item__submenu">
            <div class="kom-menu-item__submenu-content">
                @foreach (var child in MenuItem.Items)
                {
                    <MenuItemRenderer @key="child.Name" MenuItem="@child" Level="@(Level + 1)" MaxLevel="@MaxLevel" GroupStartsCollapsed="@GroupStartsCollapsed" />
                }
            </div>
        </div>
    </div>
}
else
{
    @* Leaf menu item - wrap in level-aware container; --row aligns with expandable siblings (e.g. Data Grid) *@
    <div class="kom-menu-item kom-menu-item--leaf @(Level == 0 ? "kom-menu-item--row" : "")" style="--menu-level: @Level">
        <SbNavItem Href="@GetUrl()" Text="@MenuItem.DisplayName" Match="@NavLinkMatch.All">
            <Icon>
                @if (!string.IsNullOrEmpty(MenuItem.CustomContent))
                {
                    <span class="kom-menu-item__icon kom-menu-item__icon-custom">@((MarkupString)MenuItem.CustomContent)</span>
                }
                else if (string.IsNullOrEmpty(MenuItem.Icon))
                {
                    <span class="kom-menu-item__leaf-icon-placeholder">
                        <SbIcon Name="circle" Size="SbSize.Sm" />
                    </span>
                }
                else
                {
                    <SbIcon Name="@MenuItem.Icon" Size="SbSize.Sm" />
                }
            </Icon>
        </SbNavItem>
    </div>
}

@code {
    private const string JsModulePath = "./_content/SufiChain.KomTheme.Blazor/kom-theme.js";
    private IJSObjectReference? _jsModule;
    private ElementReference _submenuRef;
    private bool _isExpanded;
    private bool _isInitialized;

    /// <summary>
    /// The menu item to render.
    /// </summary>
    [Parameter]
    public ApplicationMenuItem MenuItem { get; set; } = null!;

    /// <summary>
    /// The nesting level (0 = first level under selected group, 1 = grandchildren, 2 = great-grandchildren).
    /// </summary>
    [Parameter]
    public int Level { get; set; }

    /// <summary>
    /// Maximum level to render as expandable (children render one level deeper). Default 3 = levels 0, 1, 2 (3 levels after main parent).
    /// </summary>
    [Parameter]
    public int MaxLevel { get; set; } = 3;

    /// <summary>
    /// When true, all expandable items in this group (and their children) start collapsed. Set from the parent menu's IsCollapsed (false = group starts collapsed).
    /// </summary>
    [Parameter]
    public bool GroupStartsCollapsed { get; set; }

    protected override void OnParametersSet()
    {
        if (GroupStartsCollapsed && MenuItem.Items.Any())
        {
            _isExpanded = false;
        }
        else if (Level == 0 && MenuItem.Items.Any())
        {
            _isExpanded = true;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && MenuItem.Items.Any())
        {
            try
            {
                _jsModule = await JS.InvokeAsync<IJSObjectReference>("import", JsModulePath);
                
                if (_isExpanded)
                {
                    // Set expanded without animation on initial load
                    await _jsModule.InvokeVoidAsync("setSubmenuExpanded", _submenuRef);
                }
                else
                {
                    // Initialize collapsed state
                    await _jsModule.InvokeVoidAsync("initSubmenu", _submenuRef);
                }
                _isInitialized = true;
            }
            catch
            {
                // JS interop not available (prerendering) - CSS fallback will handle it
                _isInitialized = true;
            }
        }
    }

    private async Task ToggleExpanded()
    {
        _isExpanded = !_isExpanded;

        if (_jsModule is not null && _isInitialized)
        {
            try
            {
                await _jsModule.InvokeVoidAsync("toggleSubmenu", _submenuRef, _isExpanded);
            }
            catch
            {
                // Fallback - CSS will handle visibility
            }
        }
    }

    private string GetUrl()
    {
        var url = MenuItem.Url ?? "#";
        
        // Handle relative URLs
        if (url.StartsWith("~/"))
        {
            url = url[1..]; // Remove ~
        }
        
        return url;
    }

    public async ValueTask DisposeAsync()
    {
        if (_jsModule is not null)
        {
            try
            {
                await _jsModule.DisposeAsync();
            }
            catch
            {
                // Ignore disposal errors
            }
        }
    }
}
