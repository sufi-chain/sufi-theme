@*
    MenuItemRenderer - Renders ApplicationMenuItem as sidebar dropdown menu.
    Supports 4 levels: main parent (selected group) → children (Level 0) → grandchildren (Level 1) → great-grandchildren (Level 2) → great-great-grandchildren (Level 3).
    Expand/collapse is Blazor state + CSS only (no JS interop) to avoid height animation locks and stale module cache.
*@

@if (MenuItem.Items.Any() && Level < MaxLevel)
{
    @* Menu item with children - render as expandable dropdown; use --row when same level as leaf siblings for alignment *@
    <div class="kom-menu-item kom-menu-item--parent @(_isExpanded ? "kom-menu-item--expanded" : "") @(Level == 0 ? "kom-menu-item--row" : "")" style="--menu-level: @Level" data-kom-menu-v="2">
        <button type="button" class="kom-menu-item__header" @onclick="ToggleExpanded">
            <span class="kom-menu-item__icon @(string.IsNullOrEmpty(MenuItem.Icon) && string.IsNullOrEmpty(MenuItem.CustomContent) ? "kom-menu-item__icon--placeholder" : "")">
                @if (!string.IsNullOrEmpty(MenuItem.CustomContent))
                {
                    @((MarkupString)MenuItem.CustomContent)
                }
                else
                {
                    <SbIcon Name="@(string.IsNullOrEmpty(MenuItem.Icon) ? "circle" : MenuItem.Icon)" Size="SbSize.Sm" />
                }
            </span>
            <span class="kom-menu-item__text">@MenuItem.DisplayName</span>
            <span class="kom-menu-item__chevron">
                <SbIcon Name="chevron-down" Size="SbSize.Xs" />
            </span>
        </button>
        <div class="kom-menu-item__submenu">
            <div class="kom-menu-item__submenu-content">
                @foreach (var child in MenuItem.Items)
                {
                    <MenuItemRenderer @key="child.Name" MenuItem="@child" Level="@(Level + 1)" MaxLevel="@MaxLevel" GroupStartsCollapsed="@GroupStartsCollapsed" />
                }
            </div>
        </div>
    </div>
}
else
{
    @* Leaf menu item - wrap in level-aware container; --row aligns with expandable siblings (e.g. Data Grid) *@
    <div class="kom-menu-item kom-menu-item--leaf @(Level == 0 ? "kom-menu-item--row" : "")" style="--menu-level: @Level">
        <SbNavItem Href="@GetUrl()" Text="@MenuItem.DisplayName" Match="@NavLinkMatch.All">
            <Icon>
                @if (!string.IsNullOrEmpty(MenuItem.CustomContent))
                {
                    <span class="kom-menu-item__icon kom-menu-item__icon-custom">@((MarkupString)MenuItem.CustomContent)</span>
                }
                else if (string.IsNullOrEmpty(MenuItem.Icon))
                {
                    <span class="kom-menu-item__leaf-icon-placeholder">
                        <SbIcon Name="circle" Size="SbSize.Sm" />
                    </span>
                }
                else
                {
                    <SbIcon Name="@MenuItem.Icon" Size="SbSize.Sm" />
                }
            </Icon>
        </SbNavItem>
    </div>
}

@code {
    private bool _isExpanded;
    private bool _initialExpansionSet;

    /// <summary>
    /// The menu item to render.
    /// </summary>
    [Parameter]
    public ApplicationMenuItem MenuItem { get; set; } = null!;

    /// <summary>
    /// The nesting level (0 = first level under selected group, 1 = grandchildren, 2 = great-grandchildren).
    /// </summary>
    [Parameter]
    public int Level { get; set; }

    /// <summary>
    /// Maximum level to render as expandable (children render one level deeper). Default 4 = levels 0, 1, 2, 3 (4 levels after main parent).
    /// </summary>
    [Parameter]
    public int MaxLevel { get; set; } = 4;

    /// <summary>
    /// When true, all expandable items in this group (and their children) start collapsed. Set from the parent menu's IsCollapsed (false = group starts collapsed).
    /// </summary>
    [Parameter]
    public bool GroupStartsCollapsed { get; set; }

    protected override void OnParametersSet()
    {
        if (_initialExpansionSet || !MenuItem.Items.Any())
        {
            return;
        }

        if (GroupStartsCollapsed)
        {
            _isExpanded = false;
        }
        else if (Level == 0)
        {
            _isExpanded = true;
        }

        _initialExpansionSet = true;
    }

    private void ToggleExpanded()
    {
        _isExpanded = !_isExpanded;
        StateHasChanged();
    }

    private string GetUrl()
    {
        var url = MenuItem.Url ?? "#";

        if (url.StartsWith("~/"))
        {
            url = url[1..];
        }

        return url;
    }
}
