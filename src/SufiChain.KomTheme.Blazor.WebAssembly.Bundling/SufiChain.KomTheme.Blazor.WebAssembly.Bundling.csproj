<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>SufiChain.KomTheme.Blazor.WebAssembly.Bundling</RootNamespace>
    <GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
    <IsPackable>true</IsPackable>
    <OutputType>Library</OutputType>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>SufiChain.KomTheme.Blazor.WebAssembly.Bundling</PackageId>
    <Description>KomTheme WebAssembly bundling and style contributors for Sufi Platform.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- ABP Core for module system (only Volo.Abp.Core, NOT Volo.Abp.AspNetCore.*) -->
    <ProjectReference Include="$(SufiAbpRepoRoot)framework\SufiChain.SufiAbp.Core\SufiChain.SufiAbp.Core.csproj" Condition="'$(UseSufiAbpProjectReferences)' == 'true'" />
    <PackageReference Include="SufiChain.SufiAbp.Core" Version="$(SufiAbpVersion)" Condition="'$(UseSufiAbpProjectReferences)' != 'true'" />
  </ItemGroup>

  <ItemGroup>
    <!-- SufiAbp UI Abstractions for bundling interfaces -->
    <ProjectReference Include="$(SufiAbpRepoRoot)framework\SufiChain.SufiAbp.UI.Abstractions\SufiChain.SufiAbp.UI.Abstractions.csproj" Condition="'$(UseSufiAbpProjectReferences)' == 'true'" />
    <PackageReference Include="SufiChain.SufiAbp.UI.Abstractions" Version="$(SufiAbpVersion)" Condition="'$(UseSufiAbpProjectReferences)' != 'true'" />
  </ItemGroup>

</Project>
