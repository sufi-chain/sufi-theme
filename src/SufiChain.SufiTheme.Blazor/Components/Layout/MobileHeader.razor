@namespace SufiChain.SufiTheme.Blazor.Components.Layout
@*
    MobileHeader - Compact mobile top bar for DualSidebarLayout.
    Logo (start) + optional "Page Actions" button (end) that opens a drawer.
    Page title and breadcrumbs are not rendered here; DualSidebar keeps a screen-reader heading in content.
*@

<div class="sufi-mobile-header">
    <div class="sufi-mobile-header__row1">
        <div class="sufi-mobile-header__logo">
            @if (Logo != null)
            {
                @Logo
            }
        </div>
        @if (ShowPageActionsButton)
        {
            <SbButton Variant="SbButtonVariant.Outline" Size="SbSize.Sm" Class="sufi-mobile-header__actions-btn"
                      OnClick="OnPageActionsClick" aria-label="@PageActionsLabel">
                <StartIcon><SbIcon Name="more-vertical" Size="SbSize.Sm" /></StartIcon>
                <ChildContent>@PageActionsLabel</ChildContent>
            </SbButton>
        }
    </div>
    @if (Row2Content != null)
    {
        <div class="sufi-mobile-header__row2">
            @Row2Content
        </div>
    }
</div>

@code {
    /// <summary>
    /// Logo content (e.g. MobileTopBarLogo).
    /// </summary>
    [Parameter]
    public RenderFragment? Logo { get; set; }

    /// <summary>
    /// Whether to show the "Page Actions" button (when current page has SufiPageToolbar content).
    /// </summary>
    [Parameter]
    public bool ShowPageActionsButton { get; set; }

    /// <summary>
    /// Label for the Page Actions button and aria-label.
    /// </summary>
    [Parameter]
    public string PageActionsLabel { get; set; } = "Page Actions";

    /// <summary>
    /// Callback when the Page Actions button is clicked (open top drawer).
    /// </summary>
    [Parameter]
    public EventCallback OnPageActionsClick { get; set; }

    /// <summary>
    /// Optional second-row content. DualSidebarLayout does not supply this on mobile.
    /// </summary>
    [Parameter]
    public RenderFragment? Row2Content { get; set; }
}
