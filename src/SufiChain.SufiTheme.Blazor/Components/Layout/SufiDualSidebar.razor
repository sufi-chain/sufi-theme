@namespace SufiChain.SufiTheme.Blazor.Components.Layout

@*
    SufiDualSidebar - Container for icon rail + expandable panel
    
    Manages the dual sidebar layout pattern:
    - Contains IconRail + ExpandPanel
    - Manages expand/collapse state
    - Hover or click to expand
    - Mobile drawer fallback
*@

<div class="sufi-dual-sidebar @(_isExpanded ? "sufi-dual-sidebar--expanded" : "") @(_isPinned ? "sufi-dual-sidebar--pinned" : "") @(Open ? "sufi-dual-sidebar--open" : "") @Class"
     @onmouseenter="OnMouseEnter"
     @onmouseleave="OnMouseLeave">
    
    <CascadingValue Value="this">
        @if (IconRail != null)
        {
            <div class="sufi-dual-sidebar__rail">
                @IconRail
            </div>
        }
        
        @if (ExpandPanel != null)
        {
            <div class="sufi-dual-sidebar__panel @(_isExpanded || _isPinned ? "sufi-dual-sidebar__panel--visible" : "")">
                @ExpandPanel
            </div>
        }
    </CascadingValue>
</div>

@code {
    private bool _isExpanded;
    private bool _isPinned;
    
    /// <summary>
    /// Icon rail content.
    /// </summary>
    [Parameter]
    public RenderFragment? IconRail { get; set; }
    
    /// <summary>
    /// Expandable panel content.
    /// </summary>
    [Parameter]
    public RenderFragment? ExpandPanel { get; set; }
    
    /// <summary>
    /// Whether to expand on hover.
    /// </summary>
    [Parameter]
    public bool ExpandOnHover { get; set; } = true;
    
    /// <summary>
    /// Whether the panel is pinned open.
    /// </summary>
    [Parameter]
    public bool Pinned { get; set; }
    
    /// <summary>
    /// Callback when pinned state changes.
    /// </summary>
    [Parameter]
    public EventCallback<bool> PinnedChanged { get; set; }
    
    /// <summary>
    /// When true (e.g. on mobile when menu is toggled open), adds class sufi-dual-sidebar--open
    /// so the sidebar drawer is visible.
    /// </summary>
    [Parameter]
    public bool Open { get; set; }
    
    /// <summary>
    /// Additional CSS classes.
    /// </summary>
    [Parameter]
    public string? Class { get; set; }
    
    protected override void OnParametersSet()
    {
        _isPinned = Pinned;
    }
    
    private void OnMouseEnter()
    {
        if (ExpandOnHover && !_isPinned)
        {
            _isExpanded = true;
        }
    }
    
    private void OnMouseLeave()
    {
        if (!_isPinned)
        {
            _isExpanded = false;
        }
    }
    
    /// <summary>
    /// Toggle the pinned state of the expand panel.
    /// </summary>
    public async Task TogglePinAsync()
    {
        _isPinned = !_isPinned;
        _isExpanded = _isPinned;
        await PinnedChanged.InvokeAsync(_isPinned);
    }
    
    /// <summary>
    /// Expand the panel programmatically.
    /// </summary>
    public void Expand()
    {
        _isExpanded = true;
        StateHasChanged();
    }
    
    /// <summary>
    /// Collapse the panel programmatically.
    /// </summary>
    public void Collapse()
    {
        if (!_isPinned)
        {
            _isExpanded = false;
            StateHasChanged();
        }
    }
    
    /// <summary>
    /// Whether the panel is currently expanded.
    /// </summary>
    public bool IsExpanded => _isExpanded || _isPinned;
    
    /// <summary>
    /// Whether the panel is pinned open.
    /// </summary>
    public bool IsPinned => _isPinned;
}
