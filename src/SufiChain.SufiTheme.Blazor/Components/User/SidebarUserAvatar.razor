@using Microsoft.Extensions.Localization
@using SufiChain.SufiBlazor.Components
@using SufiChain.SufiBlazor.Icons
@using SufiChain.SufiPlatform.UI.Authentication
@using SufiChain.SufiPlatform.UI.Localization
@using SufiChain.SufiPlatform.UI.Navigation
@using Microsoft.AspNetCore.Components.Routing
@inject ICurrentUser CurrentUser
@inject IMenuManager MenuManager
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@inject IOptions<AuthenticationOptions> AuthenticationOptions
@inject IStringLocalizer<SufiFrameworkResource> L
@implements IDisposable

@*
    SidebarUserAvatar - Compact user avatar for the icon rail footer
    
    Features:
    - Avatar image or initials
    - Status indicator
    - Click to open user menu (Profile, Change Password, Logout, host-contributed items) - consistent with Culture Selector
    - Uses StandardMenus.User and IMenuManager for extensibility
*@

<div class="sufi-sidebar-user-avatar @(CurrentUser.IsAuthenticated ? "" : "sufi-sidebar-user-avatar--guest")">
    @if (CurrentUser.IsAuthenticated)
    {
        <SbMenu Open="@_menuOpen" OpenChanged="@OnMenuOpenChanged" Placement="@Placement" Class="sufi-sidebar-user-avatar__menu">
            <AnchorContent>
                <button type="button" class="sufi-sidebar-user-avatar__button" @onclick="ToggleMenu" title="@CurrentUser.UserName">
                    <span class="sufi-sidebar-user-avatar__initials">@GetInitials()</span>
                    <span class="sufi-sidebar-user-avatar__status"></span>
                </button>
            </AnchorContent>
            <ChildContent>
                @* Profile header: avatar, name, email *@
                <div class="sufi-sidebar-user-menu__header">
                    <div class="sufi-sidebar-user-menu__avatar">@GetInitials()</div>
                    <div class="sufi-sidebar-user-menu__info">
                        <span class="sufi-sidebar-user-menu__name">@CurrentUser.UserName</span>
                        @if (!string.IsNullOrEmpty(CurrentUser.Email))
                        {
                            <span class="sufi-sidebar-user-menu__email">@CurrentUser.Email</span>
                        }
                    </div>
                </div>
                <SbDivider />
                @if (_userMenu != null)
                {
                    @foreach (var item in _userMenu.Items.Where(i => !IsLogoutItem(i)))
                    {
                        var menuItem = item;
                        <SbMenuItem OnClick="() => NavigateToAsync(menuItem.Url, menuItem.Target)">
                            <Icon>
                                @if (!string.IsNullOrEmpty(menuItem.Icon) && SufiIcons.GetIcon(menuItem.Icon) != null)
                                {
                                    <SbIcon Name="@menuItem.Icon" />
                                }
                            </Icon>
                            <ChildContent>@menuItem.DisplayName</ChildContent>
                        </SbMenuItem>
                    }
                }
                <SbDivider />
                <SbMenuItem OnClick="Logout">
                    <Icon><SbIcon Name="log-out" /></Icon>
                    <ChildContent>@L["Logout"]</ChildContent>
                </SbMenuItem>
            </ChildContent>
        </SbMenu>
    }
    else
    {
        <button type="button" class="sufi-sidebar-user-avatar__button" @onclick="Login" title="Login">
            <SbIcon Name="user" Size="SbSize.Md" />
        </button>
    }
</div>

@code {
    /// <summary>
    /// Popover placement for the user menu. Defaults to <c>TopEnd</c> (icon-rail footer).
    /// Top-bar layouts should pass <c>BottomEnd</c> so the menu opens downward.
    /// </summary>
    [Parameter]
    public SbPlacement Placement { get; set; } = SbPlacement.TopEnd;

    private ApplicationMenu? _userMenu;
    private bool _menuOpen;

    protected override async Task OnInitializedAsync()
    {
        _userMenu = await MenuManager.GetAsync(StandardMenus.User);
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private async void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        _userMenu = await MenuManager.GetAsync(StandardMenus.User);
        await InvokeAsync(StateHasChanged);
    }

    private void OnMenuOpenChanged(bool open)
    {
        _menuOpen = open;
    }

    private static bool IsLogoutItem(ApplicationMenuItem item)
    {
        if (item.Name?.Contains("Logout", StringComparison.OrdinalIgnoreCase) == true)
            return true;
        if (!string.IsNullOrEmpty(item.Url) && item.Url.Contains("logout", StringComparison.OrdinalIgnoreCase))
            return true;
        return false;
    }

    private string GetInitials()
    {
        if (string.IsNullOrEmpty(CurrentUser.UserName))
            return "?";
            
        var parts = CurrentUser.UserName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length >= 2)
        {
            return $"{parts[0][0]}{parts[1][0]}".ToUpperInvariant();
        }
        return CurrentUser.UserName.Length >= 2 
            ? CurrentUser.UserName[..2].ToUpperInvariant() 
            : CurrentUser.UserName.ToUpperInvariant();
    }

    private void ToggleMenu()
    {
        _menuOpen = !_menuOpen;
    }

    private async Task NavigateToAsync(string? uri, string? target = null)
    {
        if (string.IsNullOrEmpty(uri))
            return;
        
        if (target == "_blank")
        {
            await JSRuntime.InvokeVoidAsync("open", uri, target);
        }
        else
        {
            NavigationManager.NavigateTo(uri);
        }
    }

    private void Login()
    {
        NavigationManager.NavigateTo(AuthenticationOptions.Value.LoginUrl, forceLoad: true);
    }

    private void Logout()
    {
        NavigationManager.NavigateTo(AuthenticationOptions.Value.LogoutUrl, forceLoad: true);
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}
