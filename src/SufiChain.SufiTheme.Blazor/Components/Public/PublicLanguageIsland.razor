@namespace SufiChain.SufiTheme.Blazor.Components.Public
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.Extensions.Localization
@using SufiChain.SufiPlatform.UI.Browser
@using SufiChain.SufiPlatform.UI.Localization
@rendermode RenderMode.InteractiveServer
@inject ILanguageProvider LanguageProvider
@inject IPreferredLanguageService PreferredLanguageService
@inject ICookieService CookieService
@inject IJSRuntime JSRuntime
@inject IStringLocalizer<SufiFrameworkResource> L
@using SufiChain.SufiBlazor.Components.Forms

<div class="language-picker">
    <SbSelect TItem="LanguageInfo"
              TValue="string"
              Items="@_languages"
              Value="@_currentCulture"
              ValueChanged="@OnLanguageChangedAsync"
              TextField="@(language => language.DisplayName)"
              ValueField="@(language => language.CultureName)"
              Label="@L["ChooseLanguage"]" />
</div>
