@using Microsoft.AspNetCore.Components
@inherits LayoutComponentBase
@inject IOptions<SufiThemeBlazorOptions> BlazorOptions
@inject IThemeSwitchService ThemeSwitchService
@implements IDisposable

@*
    EmptyLayout - Minimal layout without navigation

    Uses SufiBlazor theme provider for consistent styling.
    Footer matches other layouts via ShowFooter + SufiFooterCopyright.
*@

<SbThemeProvider Theme="@_currentTheme" Direction="@_direction">
    <div class="sufi-empty-layout">
        <SufiPageAlert />
        <div class="sufi-empty-layout__body">
            @Body
        </div>

        @if (BlazorOptions.Value.ShowFooter)
        {
            <footer class="sufi-footer sufi-footer--inline sufi-footer--empty">
                <SufiFooterCopyright />
            </footer>
        }
    </div>
    @* Global Message/Confirm Dialog Host *@
    <SufiOverlayHost />
</SbThemeProvider>

@code {
    private SbTheme _currentTheme = SbTheme.Light;
    private SbDirection _direction = SbDirection.Ltr;

    protected override void OnInitialized()
    {
        var culture = System.Globalization.CultureInfo.CurrentUICulture;
        _direction = culture.TextInfo.IsRightToLeft ? SbDirection.Rtl : SbDirection.Ltr;
        ThemeSwitchService.ThemeChanged += OnThemeChanged;
    }

    [CascadingParameter(Name = "SufiResolvedThemeIsDark")]
    public bool? ResolvedThemeIsDark { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (ResolvedThemeIsDark is bool isDark)
        {
            _currentTheme = isDark ? SbTheme.Dark : SbTheme.Light;
            ThemeSwitchService.SeedResolved(isDark);
        }

        try
        {
            await ThemeSwitchService.GetStoredThemeAsync();
            ApplyThemeFromServiceIfChanged();
        }
        catch
        {
            // Keep the theme already chosen from the saved preference.
        }
    }

    private void ApplyThemeFromServiceIfChanged()
    {
        var theme = ThemeSwitchService.IsDarkMode ? SbTheme.Dark : SbTheme.Light;
        if (_currentTheme == theme)
        {
            return;
        }

        _currentTheme = theme;
    }

    private void OnThemeChanged(ThemeMode mode)
    {
        var theme = ThemeSwitchService.IsDarkMode ? SbTheme.Dark : SbTheme.Light;
        if (_currentTheme == theme)
        {
            return;
        }

        _currentTheme = theme;
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        ThemeSwitchService.ThemeChanged -= OnThemeChanged;
    }
}
