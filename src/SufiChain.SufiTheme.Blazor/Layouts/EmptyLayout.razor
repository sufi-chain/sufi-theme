@inherits LayoutComponentBase
@inject IOptions<SufiThemeBlazorOptions> BlazorOptions

@*
    EmptyLayout - Minimal layout without navigation

    Uses SufiBlazor theme provider for consistent styling.
    Footer matches other layouts via ShowFooter + SufiFooterCopyright.
*@

<SbThemeProvider Theme="@_currentTheme" Direction="@_direction">
    <div class="sufi-empty-layout">
        <SufiPageAlert />
        <div class="sufi-empty-layout__body">
            @Body
        </div>

        @if (BlazorOptions.Value.ShowFooter)
        {
            <footer class="sufi-footer sufi-footer--inline sufi-footer--empty">
                <SufiFooterCopyright />
            </footer>
        }
    </div>
    @* Global Message/Confirm Dialog Host *@
    <SufiOverlayHost />
</SbThemeProvider>

@code {
    private SbTheme _currentTheme = SbTheme.Light;
    private SbDirection _direction = SbDirection.Ltr;

    protected override void OnInitialized()
    {
        var culture = System.Globalization.CultureInfo.CurrentUICulture;
        _direction = culture.TextInfo.IsRightToLeft ? SbDirection.Rtl : SbDirection.Ltr;
    }
}
