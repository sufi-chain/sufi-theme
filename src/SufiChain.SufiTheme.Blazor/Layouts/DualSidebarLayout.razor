@inherits SufiLayoutBase
@using SufiChain.SufiPlatform.UI.Browser
@implements IAsyncDisposable

@* 
    DualSidebarLayout - Uses SufiBlazor Design System with SufiTheme Components
    
    This layout implements the dual sidebar pattern:
    - Sidebar full height on left (icon rail + expandable panel)
    - Header spans only content area with: Page Title/Breadcrumbs (left) | Page Actions (right)
    - System toolbar items (theme, language, login) in icon rail footer
    - Inline footer within content area
*@

<SbThemeProvider Theme="@CurrentTheme" Direction="@Direction">
    <SufiAppShell Variant="SufiAppShellVariant.DualSidebar">
        <TopBar>
            @if (_isMobile)
            {
                @* Mobile: single fixed row – logo + Page Actions only. Title and breadcrumbs are not shown in-content. *@
                <MobileHeader Logo="@_mobileLogoFragment"
                              ShowPageActionsButton="@(PageLayout.ToolbarContent != null)"
                              PageActionsLabel="@L["PageActions"].Value"
                              OnPageActionsClick="OpenMobileActionsDrawer" />
            }
            else
            {
                <SufiTopBar ShowMenuButton="false" ContentVersion="@LayoutContentVersion" RenderPageToolbar="true">
                    <StartContent>
                        <div class="sufi-topbar-page-info">
                            @if (!string.IsNullOrEmpty(PageLayout.Title))
                            {
                                <h1 class="sufi-topbar-page-title">@PageLayout.Title</h1>
                            }
                            @if (!string.IsNullOrWhiteSpace(PageLayout.Subtitle))
                            {
                                <p class="sufi-topbar-page-subtitle">@PageLayout.Subtitle</p>
                            }
                            @if (ShouldShowPageBreadcrumbs)
                            {
                                <SufiBreadcrumbs ShowHome="false" />
                            }
                        </div>
                    </StartContent>
                </SufiTopBar>
            }
        </TopBar>

        <DualSidebar>
            <SufiDualSidebar ExpandOnHover="@BlazorOptions.Value.ExpandOnHover" CanExpand="@(_selectedMenuItem?.Items.Any() == true)" Pinned="@_sidebarPinned" PinnedChanged="OnSidebarPinnedChanged"
                             Open="@(_isMobile && _mobileSidebarOpen)">
                <IconRail>
                    <SufiIconRail Dark="@BlazorOptions.Value.IconRailDarkMode">
                        <Header>
                            <a href="@BlazorOptions.Value.IconRailHomeUrl" class="sufi-icon-rail__logo" title="@BrandingProvider.AppName">
                                @if (!string.IsNullOrEmpty(BrandingProvider.LogoUrl))
                                {
                                    <img src="@BrandingProvider.LogoUrl" alt="@BrandingProvider.AppName" style="height: 32px; width: 32px; object-fit: contain;" />
                                }
                                else
                                {
                                    <SbIcon Name="grid" Size="SbSize.Lg" />
                                }
                            </a>
                        </Header>
                        <ChildContent>
                            @foreach (var menuItem in MenuItems)
                            {
                                <IconRailNavItem MenuItem="@menuItem" OnClick="() => SelectMenuItem(menuItem)" IsSelected="@IsMenuItemSelected(menuItem)" />
                            }
                        </ChildContent>
                        <Footer>
                            @* System Toolbar items (theme switch, language, user menu, etc.) *@
                            @if (ToolbarItems.Any())
                            {
                                <div class="sufi-icon-rail__toolbar">
                                    @foreach (var item in ToolbarItems)
                                    {
                                        <DynamicComponent Type="@item.ComponentType" />
                                    }
                                </div>
                            }
                            <SidebarUserAvatar />
                        </Footer>
                    </SufiIconRail>
                </IconRail>
                <ExpandPanel>
                    @if (_selectedMenuItem?.Items.Any() == true)
                    {
                        <SufiExpandPanel>
                            <Header>
                                <div class="sufi-expand-panel__header-content">
                                    <span class="sufi-expand-panel__title">@BrandingProvider.AppName</span>
                                    <SbButton Variant="SbButtonVariant.Ghost" Size="SbSize.Sm" OnClick="ToggleSidebarPin" title="@(_sidebarPinned ? "Unpin sidebar" : "Pin sidebar")">
                                        <SbIcon Name="@(_sidebarPinned ? "unpin" : "thumbtack")" Size="SbSize.Sm" />
                                    </SbButton>
                                </div>
                            </Header>
                            <ChildContent>
                                <div class="sufi-nav-group">
                                    <span class="sufi-nav-group__label">@_selectedMenuItem.DisplayName</span>
                                    <SbNavMenu>
                                        @foreach (var child in _selectedMenuItem.Items)
                                        {
                                            <MenuItemRenderer @key="child.Name" MenuItem="@child" Level="0" GroupStartsCollapsed="@(_selectedMenuItem.IsCollapsed == false)" />
                                        }
                                    </SbNavMenu>
                                </div>
                            </ChildContent>
                            @* <Footer>
                                <SidebarUserProfile />
                            </Footer> *@
                        </SufiExpandPanel>
                    }
                </ExpandPanel>
            </SufiDualSidebar>
        </DualSidebar>

        <ChildContent>
            <div class="sufi-content-wrapper @(_isMobile ? "sufi-content-wrapper--mobile-bottom-menu" : "")">
                @* Mobile: backdrop when sidebar drawer is open *@
                @if (_isMobile && _mobileSidebarOpen)
                {
                    <div class="sufi-dual-sidebar-backdrop" @onclick="ToggleMobileSidebar" aria-hidden="true"></div>
                }
                @* Mobile: keep a screen-reader heading; visual title/breadcrumbs stay on desktop. *@
                @if (_isMobile && !string.IsNullOrEmpty(PageLayout.Title))
                {
                    <h1 class="sb-sr-only">@PageLayout.Title</h1>
                }
                <SufiPageAlert />
                <SufiLayoutHook Name="@LayoutHooks.Body.First" />
                
                @* SufiPageToolbar only registers toolbar content; title/breadcrumbs are in the desktop top bar. *@
                <SufiPageToolbar />
                
                <div class="sufi-content-body">
                    @Body
                </div>
                
                <SufiLayoutHook Name="@LayoutHooks.Body.Last" />
                <SufiDynamicLayoutComponent />
                
                @* Footer inside content area *@
                @if (BlazorOptions.Value.ShowFooter)
                {
                    <footer class="sufi-footer sufi-footer--inline">
                        <SufiFooterCopyright />
                    </footer>
                }
            </div>
        </ChildContent>
    </SufiAppShell>
    @* Mobile: fixed bottom bar with center menu button and shortcuts (replaces header hamburger) *@
    @if (_isMobile)
    {
        <MobileBottomMenu OnOpenMenu="ToggleMobileSidebar"
                          AriaLabel="@L["MobileNavigation"].Value"
                          OpenMenuAriaLabel="@L["Menu"].Value">
            <LeftShortcuts>
                @foreach (var shortcut in GetMobileShortcuts().Take(2))
                {
                    <a href="@shortcut.Url" class="sufi-mobile-bottom-menu__shortcut" aria-label="@L[shortcut.DisplayName].Value">
                        <SbIcon Name="@shortcut.Icon" Size="SbSize.Lg" />
                    </a>
                }
            </LeftShortcuts>
            <RightShortcuts>
                @foreach (var shortcut in GetMobileShortcuts().Skip(2).Take(2))
                {
                    <a href="@shortcut.Url" class="sufi-mobile-bottom-menu__shortcut" aria-label="@L[shortcut.DisplayName].Value">
                        <SbIcon Name="@shortcut.Icon" Size="SbSize.Lg" />
                    </a>
                }
            </RightShortcuts>
        </MobileBottomMenu>
        @* Mobile: top drawer for Page Actions (SufiPageToolbar content) *@
        @if (PageLayout.ToolbarContent is RenderFragment toolbarFragment)
        {
            <SbDrawer @bind-Open="_mobileActionsDrawerOpen" Title="@L["PageActions"].Value"
                      Placement="SbDrawerPlacement.Top" Height="max-content" Class="sufi-mobile-actions-drawer">
                @toolbarFragment
            </SbDrawer>
        }
    }
    @* Global Message/Confirm Dialog Host *@
    <SufiOverlayHost />
</SbThemeProvider>

@code {
    private const string SidebarPinnedStorageKey = "sufi-sufi-sidebar-pinned";
    private const int MobileBreakpointPx = 768;

    private bool _sidebarPinned;
    private bool _isMobile;
    private bool _mobileSidebarOpen;
    private bool _mobileActionsDrawerOpen;
    private ApplicationMenuItem? _selectedMenuItem;
    private string _viewportListenerId = Guid.NewGuid().ToString("N");
    private DotNetObjectReference<DualSidebarLayout>? _dotNetRef;
    private bool _viewportInitialized;
    private bool _pinRestored;

    private RenderFragment? _mobileLogoFragment => builder =>
    {
        builder.OpenComponent<MobileTopBarLogo>(0);
        builder.AddAttribute(1, "BrandingProvider", BrandingProvider);
        builder.AddAttribute(2, "ShowAppName", true);
        builder.CloseComponent();
    };

    [Inject]
    private ILocalStorageService LocalStorage { get; set; } = null!;

    [Inject]
    private IJSRuntime JSRuntime { get; set; } = null!;

    [JSInvokable]
    public void OnViewportBreakpointChanged(bool isMobile)
    {
        if (_isMobile != isMobile)
        {
            _isMobile = isMobile;
            if (!_isMobile)
                _mobileSidebarOpen = false;
            InvokeAsync(StateHasChanged);
        }
    }

    protected override Task OnInitializedLayoutAsync()
    {
        // Select IconRail item from current URL so reload/direct navigation shows correct active menu.
        // Stays null on routes without a rail item (e.g. dashboard via logo).
        SyncSelectedMenuItemFromUrl();
        // Close mobile sidebar when navigation occurs (e.g. user clicked a menu link)
        NavigationManager.LocationChanged += CloseMobileSidebarOnNavigate;
        return Task.CompletedTask;
    }

    private void CloseMobileSidebarOnNavigate(object? sender, LocationChangedEventArgs e)
    {
        _mobileSidebarOpen = false;
        SyncSelectedMenuItemFromUrl();
        _ = InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// Sets <see cref="_selectedMenuItem"/> to the top-level menu item that contains the current URL
    /// (for example /panel/admin/cms/content/{id} → CMS, /panel/admin/identity → Administration, /panel/portal → Portal).
    /// </summary>
    private void SyncSelectedMenuItemFromUrl()
    {
        // Clear when the current URL is not under any rail item (e.g. dashboard via logo).
        _selectedMenuItem = GetTopLevelMenuItemForCurrentUrl();
    }

    /// <summary>
    /// Finds the top-level IconRail menu item whose URL or any descendant URL matches the current path.
    /// Unregistered routes under a module rail stay on that module. Other /panel/admin and /panel/portal
    /// routes stay on Administration or Portal.
    /// </summary>
    private ApplicationMenuItem? GetTopLevelMenuItemForCurrentUrl()
    {
        var path = GetCurrentPath();
        if (string.IsNullOrEmpty(path))
            return null;

        if (IsPanelHomePath(path))
            return null;

        var matches = new List<ApplicationMenuItem>();
        foreach (var item in MenuItems)
        {
            if (MenuItemOrDescendantMatchesPath(item, path))
                matches.Add(item);
        }

        var zoneMenuName = GetPanelZoneMenuName(path);

        // Zone routes (/panel/portal|admin/...) must keep the IconRail selection even when
        // the exact page URL is not registered (e.g. host redirects calendar → calendar-pro).
        // Returning null here dumps the full menu tree into the expand panel.
        // A module rail such as CMS wins when the path continues its own prefix
        // (for example /panel/admin/cms/content/{id} stays on CMS).
        if (matches.Count == 0)
        {
            if (zoneMenuName == null)
                return null;

            var moduleMatch = FindTopLevelModuleMenuByPathPrefix(path, zoneMenuName);
            if (moduleMatch != null)
                return moduleMatch;

            return MenuItems.FirstOrDefault(m =>
                string.Equals(m.Name, zoneMenuName, StringComparison.Ordinal));
        }

        if (zoneMenuName != null)
        {
            var zoneMatch = matches.FirstOrDefault(m =>
                string.Equals(m.Name, zoneMenuName, StringComparison.Ordinal));
            if (zoneMatch != null)
                return zoneMatch;
        }

        return matches[0];
    }

    private static bool IsPanelHomePath(string path)
    {
        return path.Equals("/panel", StringComparison.OrdinalIgnoreCase)
               || path.Equals("/panel/dashboard", StringComparison.OrdinalIgnoreCase)
               || path.StartsWith("/panel/dashboard/", StringComparison.OrdinalIgnoreCase);
    }

    private static string? GetPanelZoneMenuName(string path)
    {
        if (path.StartsWith("/panel/admin", StringComparison.OrdinalIgnoreCase) &&
            (path.Length == "/panel/admin".Length || path["/panel/admin".Length] == '/'))
        {
            return ApplicationMenuExtensions.AdministrationMenuName;
        }

        if (path.StartsWith("/panel/portal", StringComparison.OrdinalIgnoreCase) &&
            (path.Length == "/panel/portal".Length || path["/panel/portal".Length] == '/'))
        {
            return ApplicationMenuExtensions.PortalMenuName;
        }

        return null;
    }

    /// <summary>
    /// Picks a non-zone rail whose menu URLs share the longest path prefix with <paramref name="path"/>.
    /// The shared prefix must extend past /panel/admin or /panel/portal, so an unregistered CMS
    /// content editor stays on CMS and an unregistered Identity page still falls through to Administration.
    /// </summary>
    private ApplicationMenuItem? FindTopLevelModuleMenuByPathPrefix(string path, string zoneMenuName)
    {
        var pathSegments = SplitPathSegments(path);
        const int zoneRootSegments = 2;
        ApplicationMenuItem? best = null;
        var bestSegments = zoneRootSegments;

        foreach (var item in MenuItems)
        {
            if (string.Equals(item.Name, zoneMenuName, StringComparison.Ordinal))
                continue;

            var shared = MaxSharedPrefixSegments(item, pathSegments);
            if (shared > bestSegments)
            {
                bestSegments = shared;
                best = item;
            }
        }

        return best;
    }

    private static int MaxSharedPrefixSegments(ApplicationMenuItem item, IReadOnlyList<string> pathSegments)
    {
        var best = SharedPrefixSegments(item.Url, pathSegments);
        foreach (var child in item.Items)
        {
            var childBest = MaxSharedPrefixSegments(child, pathSegments);
            if (childBest > best)
                best = childBest;
        }

        return best;
    }

    private static int SharedPrefixSegments(string? itemUrl, IReadOnlyList<string> pathSegments)
    {
        if (string.IsNullOrEmpty(itemUrl) || pathSegments.Count == 0)
            return 0;

        var urlPath = itemUrl.StartsWith("/", StringComparison.Ordinal) ? itemUrl : "/" + itemUrl;
        var urlSegments = SplitPathSegments(urlPath);
        var count = 0;
        var limit = Math.Min(urlSegments.Count, pathSegments.Count);
        while (count < limit && string.Equals(urlSegments[count], pathSegments[count], StringComparison.OrdinalIgnoreCase))
            count++;

        return count;
    }

    private static List<string> SplitPathSegments(string path)
    {
        return path.Split('/', StringSplitOptions.RemoveEmptyEntries).ToList();
    }

    private static bool MenuItemOrDescendantMatchesPath(ApplicationMenuItem item, string currentPath)
    {
        if (PathMatches(currentPath, item.Url))
            return true;
        foreach (var child in item.Items)
        {
            if (MenuItemOrDescendantMatchesPath(child, currentPath))
                return true;
        }
        return false;
    }

    private static bool PathMatches(string currentPath, string? itemUrl)
    {
        if (string.IsNullOrEmpty(itemUrl))
            return false;
        var urlPath = itemUrl.StartsWith("/", StringComparison.Ordinal) ? itemUrl : "/" + itemUrl;
        if (currentPath.Equals(urlPath, StringComparison.OrdinalIgnoreCase))
            return true;
        if (!currentPath.StartsWith(urlPath, StringComparison.OrdinalIgnoreCase))
            return false;
        return urlPath.Length == currentPath.Length || currentPath[urlPath.Length] == '/';
    }

    private string GetCurrentPath()
    {
        try
        {
            return new Uri(NavigationManager.Uri).AbsolutePath;
        }
        catch
        {
            return string.Empty;
        }
    }

    public override void Dispose()
    {
        NavigationManager.LocationChanged -= CloseMobileSidebarOnNavigate;
        base.Dispose();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);

        // Restore sidebar pinned state as soon as localStorage is available (independent of viewport).
        // Run until we've restored once so we don't depend on viewport init succeeding (fixes: menu closed on load while icon shows pinned).
        if (!_pinRestored)
        {
            try
            {
                var stored = await LocalStorage.GetItemAsync(SidebarPinnedStorageKey);
                if (!string.IsNullOrEmpty(stored) && bool.TryParse(stored, out var pinned) && _sidebarPinned != pinned)
                {
                    _sidebarPinned = pinned;
                    StateHasChanged();
                }
                _pinRestored = true;
            }
            catch
            {
                // JS/localStorage not available yet (e.g. prerender) – will retry on next OnAfterRenderAsync
            }
        }

        // Retry viewport init until JS is available (e.g. after prerender, or script not yet loaded on reload)
        if (!_viewportInitialized)
        {
            try
            {
                _dotNetRef = DotNetObjectReference.Create(this);
                var isMobile = await JSRuntime.InvokeAsync<bool>("SufiThemeViewportInit", _dotNetRef, MobileBreakpointPx, _viewportListenerId);
                _viewportInitialized = true;
                _isMobile = isMobile;
                StateHasChanged();
            }
            catch (JSDisconnectedException)
            {
                _ = InvokeAsync(StateHasChanged);
            }
            catch (Exception)
            {
                await Task.Delay(150);
                _ = InvokeAsync(StateHasChanged);
            }
        }
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            // Only call JS when we actually initialized in the browser (skip during prerender dispose)
            if (_viewportInitialized && _viewportListenerId != null)
            {
                await JSRuntime.InvokeVoidAsync("SufiThemeViewportDispose", _viewportListenerId);
            }
        }
        catch (ObjectDisposedException)
        {
            // Module or runtime already disposed
        }
        catch (JSDisconnectedException)
        {
            // Circuit already disconnected – cannot call JS; skip cleanup
        }
        catch (InvalidOperationException)
        {
            // Prerender / static render – JS interop not allowed
        }
        finally
        {
            _dotNetRef?.Dispose();
        }
    }

    private async Task OnSidebarPinnedChanged(bool pinned)
    {
        _sidebarPinned = pinned;
        await PersistSidebarPinnedAsync(pinned);
        await InvokeAsync(StateHasChanged);
    }

    private void ToggleMobileSidebar()
    {
        _mobileSidebarOpen = !_mobileSidebarOpen;
    }

    private IReadOnlyList<MobileMenuShortcut> GetMobileShortcuts()
    {
        return BlazorOptions.Value.MobileShortcuts
            .OrderBy(x => x.Order)
            .Take(4)
            .ToList();
    }

    private void OpenMobileActionsDrawer()
    {
        _mobileActionsDrawerOpen = true;
    }

    private async Task ToggleSidebarPin()
    {
        _sidebarPinned = !_sidebarPinned;
        await PersistSidebarPinnedAsync(_sidebarPinned);
        await InvokeAsync(StateHasChanged);
    }

    private async Task PersistSidebarPinnedAsync(bool pinned)
    {
        try
        {
            await LocalStorage.SetItemAsync(SidebarPinnedStorageKey, pinned.ToString());
        }
        catch
        {
            // Ignore storage errors (e.g. private browsing)
        }
    }

    private void SelectMenuItem(ApplicationMenuItem menuItem)
    {
        _selectedMenuItem = menuItem;
        if (!menuItem.Items.Any() && !string.IsNullOrWhiteSpace(menuItem.Url))
        {
            NavigationManager.NavigateTo(menuItem.Url);
        }
        StateHasChanged();
    }

    private bool IsMenuItemSelected(ApplicationMenuItem menuItem)
    {
        return _selectedMenuItem?.Name == menuItem.Name;
    }
}
