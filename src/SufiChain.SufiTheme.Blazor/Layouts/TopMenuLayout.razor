@inherits SufiLayoutBase
@using Microsoft.Extensions.Localization
@using SufiChain.SufiPlatform.UI.Localization
@using SufiChain.SufiTheme.Blazor.Components.Public
@inject IStringLocalizer<SufiFrameworkResource> FrameworkL

<HeadContent>
    <link rel="stylesheet" href="/landing/generic-site.css?v=public-ssr-1" />
    <link rel="stylesheet" href="/_content/SufiChain.SufiTheme.Blazor/public-site-layout.css?v=public-ssr-1" />
</HeadContent>

<SbThemeProvider Theme="SbTheme.Dark" Direction="@Direction">
    <div class="public-site-shell">
        <PublicSiteHeader MenuItems="MenuItems" CurrentPath="@CurrentPath" />

        <main id="main-content" class="public-site-main">
            <SufiPageAlert />
            <SufiLayoutHook Name="@LayoutHooks.Body.First" />
            <SufiPageToolbar />
            @Body
            <SufiLayoutHook Name="@LayoutHooks.Body.Last" />
            <SufiDynamicLayoutComponent />
        </main>

        <PublicSiteFooter Description="@FrameworkL["FooterDescription"]"
                          Notice="@FrameworkL["FooterNotice"]"
                          ContactLabel="@FrameworkL["FooterContact"]"
                          Release="@FrameworkL["FooterRelease"]" />
        <SufiOverlayHost />
    </div>
</SbThemeProvider>
