<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>SufiChain.KomTheme.Blazor.Server</RootNamespace>
    <GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
    <IsPackable>true</IsPackable>
    <OutputType>Library</OutputType>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>SufiChain.KomTheme.Blazor.Server</PackageId>
    <Description>KomTheme Blazor Server components and layouts for Sufi Platform.</Description>
  </PropertyGroup>

  <PropertyGroup>
    <SufiAbpRepoRoot>$(MSBuildThisFileDirectory)..\..\..\..\sufi-abp\</SufiAbpRepoRoot>
    <UseSufiAbpProjectReferences Condition="'$(UseSufiAbpProjectReferences)' == '' and Exists('$(SufiAbpRepoRoot)framework\SufiChain.SufiAbp.UI.Blazor.Server\SufiChain.SufiAbp.UI.Blazor.Server.csproj')">true</UseSufiAbpProjectReferences>
  </PropertyGroup>

  <ItemGroup Condition="'$(UseSufiAbpProjectReferences)' == 'true'">
    <ProjectReference Include="$(SufiAbpRepoRoot)framework\SufiChain.SufiAbp.Core\SufiChain.SufiAbp.Core.csproj" />
    <ProjectReference Include="$(SufiAbpRepoRoot)framework\SufiChain.SufiAbp.Security\SufiChain.SufiAbp.Security.csproj" />
    <ProjectReference Include="$(SufiAbpRepoRoot)framework\SufiChain.SufiAbp.UI\SufiChain.SufiAbp.UI.csproj" />
    <ProjectReference Include="$(SufiAbpRepoRoot)framework\SufiChain.SufiAbp.MultiTenancy\SufiChain.SufiAbp.MultiTenancy.csproj" />
    <ProjectReference Include="$(SufiAbpRepoRoot)framework\SufiChain.SufiAbp.Features\SufiChain.SufiAbp.Features.csproj" />
    <ProjectReference Include="$(SufiAbpRepoRoot)framework\SufiChain.SufiAbp.UI.Blazor.Server\SufiChain.SufiAbp.UI.Blazor.Server.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(UseSufiAbpProjectReferences)' != 'true'">
    <PackageReference Include="SufiChain.SufiAbp.Core" Version="1.0.0-alpha.1.0" />
    <PackageReference Include="SufiChain.SufiAbp.Security" Version="1.0.0-alpha.1.0" />
    <PackageReference Include="SufiChain.SufiAbp.UI" Version="1.0.0-alpha.1.0" />
    <PackageReference Include="SufiChain.SufiAbp.MultiTenancy" Version="1.0.0-alpha.1.0" />
    <PackageReference Include="SufiChain.SufiAbp.Features" Version="1.0.0-alpha.1.0" />
    <PackageReference Include="SufiChain.SufiAbp.UI.Blazor.Server" Version="1.0.0-alpha.1.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SufiChain.KomTheme.Blazor\SufiChain.KomTheme.Blazor.csproj" />
  </ItemGroup>

</Project>
